@charset "utf-8";

:root { --navy: #071521; --panel: #0d202e; --blue: #39c8f5; --ice: #bceeff; --white: #f5fbff; --grey: #a8bdca; --border: #1b4054; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { background: var(--navy); color: var(--white); font-family: Montserrat, Arial, sans-serif; line-height: 1.6; }

a { color: inherit; text-decoration: none; }

.container { width: min(1120px, 90%); margin: auto; }

header { background: rgba(7, 21, 33, 0.97); border-bottom: 1px solid var(--border); position: sticky; top: 0px; z-index: 10; }

nav { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }

.logo { font-family: "Barlow Condensed", sans-serif; font-size: 29px; font-weight: 900; letter-spacing: 1px; }

.logo span, h1 span, h2 span { color: var(--blue); }

.nav-links { display: flex; align-items: center; gap: 19px; flex-wrap: wrap; font-size: 11px; font-weight: 700; text-transform: uppercase; }

.nav-links a:hover { color: var(--blue); }

.nav-cta { border: 1px solid var(--blue); padding: 9px 13px; color: var(--blue); }

.hero { min-height: 540px; display: flex; align-items: center; background: linear-gradient(90deg, rgba(4, 16, 26, 0.96), rgba(4, 16, 26, 0.72), rgba(4, 16, 26, 0.28)), url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1600&q=85") center center / cover no-repeat; }

.hero-content { padding: 75px 0px; max-width: 690px; }

.eyebrow { color: var(--blue); font-size: 11px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 17px; }

h1, h2, h3 { font-family: "Barlow Condensed", Impact, sans-serif; text-transform: uppercase; line-height: 1.05; }

h1 { font-size: clamp(57px, 11vw, 100px); font-weight: 900; margin-bottom: 18px; }

.tagline { letter-spacing: 4px; font-weight: 700; margin-bottom: 16px; }

.hero p { color: rgb(209, 224, 233); max-width: 480px; font-size: 14px; margin-bottom: 27px; }

.button { display: inline-block; background: var(--blue); color: rgb(4, 19, 30); border: 1px solid var(--blue); padding: 13px 20px; font-size: 11px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; transition: 0.2s; }

.button:hover { background: var(--ice); border-color: var(--ice); }

.button-outline { background: transparent; color: var(--white); border-color: var(--blue); margin-left: 8px; }

.button-outline:hover { color: var(--navy); }

.stats { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: rgb(9, 27, 41); }

.stat { text-align: center; padding: 23px 10px; border-right: 1px solid var(--border); }

.stat:last-child { border-right-width: medium; border-right-style: none; border-right-color: currentcolor; }

.stat strong { display: block; color: var(--blue); font-family: "Barlow Condensed", sans-serif; font-size: 26px; }

.stat span { font-size: 10px; color: var(--grey); text-transform: uppercase; letter-spacing: 1px; }

section { padding: 75px 0px; scroll-margin-top: 85px; }

.section-heading { margin-bottom: 32px; }

.section-heading h2 { font-size: clamp(37px, 7vw, 55px); margin-bottom: 12px; }

.section-heading p { color: var(--grey); font-size: 13px; max-width: 570px; }

.programs { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 18px; }

.program-card { background: var(--panel); border: 1px solid var(--border); overflow: hidden; transition: 0.2s; }

.program-card:hover { border-color: var(--blue); transform: translateY(-4px); }

.program-image { height: 185px; background-position: center center; background-size: cover; }

.strength { background-image: url("https://images.unsplash.com/photo-1583454110551-21f2fa2afe61?auto=format&fit=crop&w=800&q=80"); }

.conditioning { background-image: url("https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=800&q=80"); }

.personal { background-image: url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=800&q=80"); }

.program-info { padding: 22px; }

.program-info h3 { font-size: 25px; margin-bottom: 10px; }

.program-info p { color: var(--grey); font-size: 12px; }

.about { background: rgb(10, 28, 41); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

.about-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 40px; }

.about-image { min-height: 320px; background: linear-gradient(0deg, rgba(5, 20, 32, 0.12), rgba(5, 20, 32, 0.12)), url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1000&q=80") center center / cover; }

.about-copy h2 { font-size: clamp(38px, 6vw, 55px); margin-bottom: 17px; }

.about-copy p { color: var(--grey); font-size: 13px; margin-bottom: 20px; }

.features { list-style: none; margin-bottom: 25px; }

.features li { margin: 9px 0px; font-size: 12px; }

.features li::before { content: "âœ“"; color: var(--blue); font-weight: 900; margin-right: 10px; }

.membership-grid { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 17px; }

.membership-card { background: var(--panel); border: 1px solid var(--border); padding: 25px 20px; }

.membership-card.featured { border-color: var(--blue); box-shadow: rgba(57, 200, 245, 0.08) 0px 0px 20px; }

.membership-card h3 { font-size: 27px; margin-bottom: 10px; }

.price { color: var(--blue); font-size: 32px; font-weight: 800; }

.per-month { color: var(--grey); font-size: 11px; margin-bottom: 18px; }

.membership-card p { color: var(--grey); font-size: 12px; margin-bottom: 18px; }

.membership-card .button { display: block; text-align: center; }

.contact { text-align: center; background: linear-gradient(135deg, rgb(16, 46, 66), rgb(7, 21, 33) 70%); border-top: 1px solid var(--border); }

.contact h2 { font-size: clamp(40px, 8vw, 65px); margin-bottom: 15px; }

.contact p { color: var(--grey); max-width: 520px; font-size: 13px; margin: 0px auto 25px; }

footer { border-top: 1px solid var(--border); text-align: center; color: var(--grey); font-size: 11px; padding: 25px 0px; }

footer span { color: var(--blue); }

@media (max-width: 760px) {
  nav { flex-direction: column; justify-content: center; padding: 8px 0px; gap: 6px; }
  nav { flex-direction: column; justify-content: center; padding: 14px 0px; gap: 12px; }
  .nav-links { justify-content: center; gap: 13px; font-size: 10px; }
  .hero { min-height: 500px; background-position: 58% center; }
  .hero-content { padding: 60px 0px; }
  .programs, .membership-grid, .about-grid { grid-template-columns: 1fr; }
  .program-image { height: 220px; }
  .about-image { min-height: 250px; }
  section { padding: 55px 0px; }
}

@media (max-width: 390px) {
  .nav-links { gap: 9px; }
  .button-outline { margin: 8px 0px 0px; }
  .stat span { font-size: 8px; }
}
